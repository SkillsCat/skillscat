# GitHub Events Worker 配置
# 复制此文件为 wrangler.github-events.toml 并填入你的配置
# 三条发现路径：
#   1. Events 轮询仅刷新 registry 已知仓库
#   2. Code Search 追头（sort=indexed）+ 日期切片回填（created:<date>..<date>），严格受 search 预算约束
#   3. HTML 仓库搜索爬虫（github.com/search），零 API 配额，入队前用 raw/HEAD/SKILL.md 校验候选
#   4. X Recent Search（需要 X_BEARER_TOKEN secret），从推文链接发现仓库
#   5. GitHub Topics HTML 爬虫（github.com/topics），零 API 配额
#   6. Awesome 列表解析（raw markdown），零 API 配额
#   7. Bluesky 搜索（无鉴权，属非官方容忍行为，默认禁用）
# GitHub API 鉴权请通过 wrangler secret 设置 `GITHUB_TOKEN` 或 `GITHUB_TOKENS`

name = "skillscat-github-events"
main = "workers/github-events.ts"
compatibility_date = "2025-01-01"
compatibility_flags = ["nodejs_compat"]

workers_dev = false
preview_urls = false

[observability]
enabled = true
head_sampling_rate = 1

# Cron Trigger - 每 5 分钟轮询一次

[triggers]
crons = ["*/5 * * * *"]

# D1 Database
[[d1_databases]]
binding = "DB"
database_name = "skillscat-db"
database_id = "<your-database-id>"

# KV - 用于存储轮询状态
[[kv_namespaces]]
binding = "KV"
id = "<your-kv-namespace-id>"

[[durable_objects.bindings]]
name = "STATE_DO"
class_name = "SkillscatStateDurableObject"
script_name = "skillscat-state"

# R2 Storage
[[r2_buckets]]
binding = "R2"
bucket_name = "skillscat-storage"

# Queue - 发送到 indexing 队列
[[queues.producers]]
binding = "INDEXING_QUEUE"
queue = "skillscat-indexing"

[vars]
# X API 为可选付费渠道。启用前请先在 X 开发者后台设置账户级消费上限，
# 再执行: wrangler secret put X_BEARER_TOKEN
# 请求预算是应用侧硬上限：默认每天 1 次、每月 30 次（分页请求也计数）。
GITHUB_EVENTS_PER_PAGE = "100"
GITHUB_EVENTS_PAGES = "1"
GITHUB_EVENTS_KNOWN_REPOS_ONLY = "1"
GITHUB_EVENTS_MAX_QUEUED_REPOS = "20"
GITHUB_EVENTS_MIN_REST_REMAINING = "1000"
GITHUB_EVENTS_REST_RESERVE = "300"
GITHUB_SEARCH_DISCOVERY_ENABLED = "1"
GITHUB_SEARCH_DISCOVERY_QUERY = "filename:SKILL.md"
GITHUB_SEARCH_DISCOVERY_PAGES = "3"
GITHUB_SEARCH_DISCOVERY_PER_PAGE = "100"
GITHUB_SEARCH_DISCOVERY_INTERVAL_SECONDS = "900"
GITHUB_DISCOVERY_CRON_INTERVAL_SECONDS = "300"
GITHUB_SEARCH_DISCOVERY_MIN_REMAINING = "2"
GITHUB_SEARCH_DISCOVERY_RESERVE = "2"
GITHUB_DISCOVERY_LOCK_TTL_SECONDS = "240"
GITHUB_EVENT_QUEUE_DEDUP_TTL_SECONDS = "300"
GITHUB_REPO_QUEUE_DEDUP_TTL_SECONDS = "86400"
GITHUB_HTML_SEARCH_DISCOVERY_ENABLED = "1"
GITHUB_HTML_SEARCH_DISCOVERY_INTERVAL_SECONDS = "900"
GITHUB_HTML_SEARCH_QUERIES = "SKILL.md in:readme,agent skills in:readme,.claude/skills in:readme"
GITHUB_HTML_SEARCH_PAGES = "3"
GITHUB_HTML_SEARCH_MAX_CANDIDATES = "200"
X_SEARCH_ENABLED = "0"
X_SEARCH_QUERY = '("SKILL.md" OR "agent skill") (github.com OR github) -is:retweet has:links'
X_SEARCH_MAX_RESULTS = "50"
X_SEARCH_MAX_TWEETS = "200"
X_SEARCH_INTERVAL_SECONDS = "900"
X_SEARCH_MAX_QUEUED_REPOS = "50"
X_SEARCH_MAX_REQUESTS_PER_DAY = "1"
X_SEARCH_MAX_REQUESTS_PER_MONTH = "30"
# GitHub Topics HTML 爬虫：零 API 配额，抓 topics 页面发现仓库
GITHUB_TOPICS_ENABLED = "1"
GITHUB_TOPICS_LIST = "claude-code-skill,claude-skills,agent-skills"
GITHUB_TOPICS_PAGES_PER_TOPIC = "2"
GITHUB_TOPICS_INTERVAL_SECONDS = "3600"
GITHUB_TOPICS_MAX_QUEUED_REPOS = "50"
# Awesome 列表解析：零 API 配额，从 raw markdown 中提取 GitHub 仓库链接
AWESOME_LISTS_ENABLED = "1"
AWESOME_LIST_URLS = "https://raw.githubusercontent.com/hesreallyhim/awesome-claude-code/main/README.md"
AWESOME_LISTS_INTERVAL_SECONDS = "86400"
AWESOME_LISTS_MAX_QUEUED_REPOS = "50"
AWESOME_LISTS_MAX_LISTS = "5"
# Bluesky 搜索：无鉴权访问属于 Bluesky 非官方容忍行为，随时可能 403，默认禁用
BSKY_SEARCH_ENABLED = "0"
BSKY_SEARCH_QUERY = '"SKILL.md" github'
BSKY_SEARCH_INTERVAL_SECONDS = "900"
BSKY_SEARCH_MAX_RESULTS = "50"
BSKY_SEARCH_MAX_QUEUED_REPOS = "50"
GITHUB_SEARCH_BACKFILL_ENABLED = "1"
GITHUB_SEARCH_BACKFILL_INTERVAL_SECONDS = "3600"
GITHUB_SEARCH_BACKFILL_START_DATE = "2025-01-01"
GITHUB_SEARCH_BACKFILL_MIN_REMAINING = "5"
GITHUB_SEARCH_BACKFILL_RESERVE = "5"
GITHUB_SEARCH_BACKFILL_MAX_PAGES = "3"

[env.production]
name = "skillscat-github-events-production"

[env.production.triggers]
crons = ["*/5 * * * *"]

[[env.production.d1_databases]]
binding = "DB"
database_name = "skillscat-db"
database_id = "<your-production-database-id>"

[[env.production.kv_namespaces]]
binding = "KV"
id = "<your-production-kv-namespace-id>"

[[env.production.durable_objects.bindings]]
name = "STATE_DO"
class_name = "SkillscatStateDurableObject"
script_name = "skillscat-state-production"

[[env.production.r2_buckets]]
binding = "R2"
bucket_name = "skillscat-storage"

[[env.production.queues.producers]]
binding = "INDEXING_QUEUE"
queue = "skillscat-indexing"

[env.production.vars]
GITHUB_EVENTS_PER_PAGE = "100"
GITHUB_EVENTS_PAGES = "1"
GITHUB_EVENTS_KNOWN_REPOS_ONLY = "1"
GITHUB_EVENTS_MAX_QUEUED_REPOS = "20"
GITHUB_EVENTS_MIN_REST_REMAINING = "1000"
GITHUB_EVENTS_REST_RESERVE = "300"
