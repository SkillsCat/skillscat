# SkillsCat 环境变量配置
# 复制此文件为 .dev.vars 并填入你的配置
# 运行 pnpm init:project 可以自动生成此文件

# ========== 自动生成的 Secrets ==========
# 这些值会由 init 脚本自动生成，无需手动填写
BETTER_AUTH_SECRET=<auto-generated>
WORKER_SECRET=<auto-generated>

# ========== GitHub OAuth ==========
# 创建 OAuth App: https://github.com/settings/developers
# Authorization callback URL 使用你的开发代理域名:
#   https://<dev-proxy-domain>/api/auth/callback/github
# 本地开发不要用 localhost —— 通过 PUBLIC_APP_URL 指定代理地址，
# OAuth redirect、cookie domain、trusted origins 都会以它为准。
PUBLIC_APP_URL=https://your-dev-proxy-domain.com
# Cloudflare Access team-domain/OIDC issuer used by RFC 9728 metadata.
# CLOUDFLARE_ACCESS_ISSUER=https://<your-team-name>.cloudflareaccess.com
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ========== GitHub Personal Access Token(s) ==========
# 创建 Token: https://github.com/settings/tokens
# 需要的权限: public_repo (用于读取公开仓库信息)
# 单 token 用 GITHUB_TOKEN；多 token 池可用 GITHUB_TOKENS，推荐逗号分隔或单行 JSON 数组
GITHUB_TOKEN=your-github-token
# GITHUB_TOKENS=["ghp_token_a","ghp_token_b"]

# ========== GitHub Public Repository Fallback ==========
# API/GraphQL 受限时，公开仓库先下载固定 commit ZIP；ZIP 超限时递归解析 HTML。
# 设为 0 可分别关闭 Web 提交或 indexing worker 的公开后备链路。
GITHUB_HTML_SUBMIT_FALLBACK_ENABLED=1
GITHUB_HTML_INDEXING_FALLBACK_ENABLED=1

# ========== IndexNow (可选，用于加速 Bing 等搜索引擎发现) ==========
# pnpm init:project 默认会自动生成 key；如有需要也可以手动覆盖
# 默认会对外提供 https://<host>/<key>.txt
# 文档: https://www.indexnow.org/documentation
INDEXNOW_KEY=

# ========== OpenRouter API (用于 AI 分类/安全分析) ==========
# 获取 API Key: https://openrouter.ai/keys
# 查看可用免费模型: https://openrouter.ai/models?q=:free
# DeepSeek V4 Flash 请求已通过 provider 路由锁定 GMICloud(折扣 SKU,允许 fallback)
OPENROUTER_API_KEY=

# 分类依次尝试 DeepSeek V4 Flash 0731、OpenRouter Free
AI_MODEL=deepseek/deepseek-v4-flash-0731
FREE_MODELS=openrouter/free

# 免费池都失败后使用付费模型
CLASSIFICATION_PAID_MODEL=deepseek/deepseek-v4-flash-0731

# ========== Security Analysis (可选调参) ==========
# 免费分析依次使用 DeepSeek V4 Flash 0731、OpenRouter Free;premium 显式使用付费模型
SECURITY_FREE_MODEL=deepseek/deepseek-v4-flash-0731
SECURITY_FREE_MODELS=openrouter/free
SECURITY_PREMIUM_MODEL=deepseek/deepseek-v4-flash-0731
# SECURITY_PREMIUM_TOP_N=50
# SECURITY_MAX_AI_FILES=8
# SECURITY_MAX_AI_TEXT_BYTES=48000
# SECURITY_STABILITY_ROUNDS=2
# SECURITY_HEURISTIC_THRESHOLD=4.5

# ========== VirusTotal Public API (可选) ==========
# Public API 需要 API Key，默认按 4 req/min 与 300 req/day 预算设计
VIRUSTOTAL_API_KEY=
# VT_ENABLED=1
# VT_MINUTE_REQUEST_BUDGET=4
# VT_DAILY_REQUEST_BUDGET=300
# VT_UPLOAD_MAX_BYTES=33554432

# ========== Rate Limit Adaptive Penalty (可选) ==========
# 仅在需要调参时设置，不设置则使用系统默认:
# BURST_WINDOW=120s, BURST_THRESHOLD=3, MAX_LEVEL=3, TTL(1/2/3)=300/900/1800s
# RATE_LIMIT_BURST_WINDOW_SECONDS=120
# RATE_LIMIT_BURST_THRESHOLD=3
# RATE_LIMIT_MAX_PENALTY_LEVEL=3
# RATE_LIMIT_PENALTY_TTL_LEVEL_1_SECONDS=300
# RATE_LIMIT_PENALTY_TTL_LEVEL_2_SECONDS=900
# RATE_LIMIT_PENALTY_TTL_LEVEL_3_SECONDS=1800
