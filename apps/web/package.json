{
  "name": "@skillscat/web",
  "version": "0.9.4",
  "type": "module",
  "scripts": {
    "build:sw": "node scripts/build-sw.mjs",
    "dev": "pnpm build:sw && vite dev",
    "build": "pnpm build:sw && vite build",
    "prepare:assetsignore": "node scripts/prepare-assetsignore.mjs",
    "preview": "node scripts/preview.mjs",
    "preview:prod": "node scripts/preview.mjs --prod-data",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "lint": "eslint .",
    "deploy": "wrangler deploy -c wrangler.state.toml --env production && pnpm build && pnpm prepare:assetsignore && wrangler deploy -c wrangler.preview.toml --env production",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply skillscat-db --local -c wrangler.preview.toml",
    "db:migrate:prod": "wrangler d1 migrations apply skillscat-db --remote -c wrangler.preview.toml --env production",
    "db:studio": "drizzle-kit studio",
    "tags:normalize": "node scripts/normalize-skill-tags.mjs"
  },
  "dependencies": {
    "@cf-wasm/resvg": "^0.4.0",
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/svelte": "^1.1.5",
    "better-auth": "^1.7.1",
    "bits-ui": "^2.19.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "marked": "^18.0.10",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260822.1",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@unocss/preset-icons": "^66.8.1",
    "@unocss/preset-wind": "^66.8.1",
    "@unocss/reset": "^66.8.1",
    "@unocss/svelte-scoped": "^66.8.1",
    "@unocss/transformer-directives": "^66.8.1",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "unocss": "^66.8.1",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  }
}
